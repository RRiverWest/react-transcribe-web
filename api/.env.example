# APIサーバーの待ち受けポート
PORT=3001

# AWS 設定 (認証情報は AWS_ACCESS_KEY_ID / AWS_SECRET_ACCESS_KEY か
# ~/.aws/credentials, IAMロール等で解決されます)
AWS_REGION=ap-northeast-1

# 文字起こし設定
LANGUAGE_CODE=ja-JP
MEDIA_SAMPLE_RATE=44100

# Bedrock 要約設定
# 要約に使うモデル ID (既定: Claude 3 Haiku)
BEDROCK_MODEL_ID=anthropic.claude-3-haiku-20240307-v1:0
# Bedrock を呼ぶリージョン (未指定なら AWS_REGION を流用)
# BEDROCK_REGION=ap-northeast-1
# 要約を許可する最小文字数 (これ未満は要約しない)
SUMMARY_MIN_CHARS=200

# フロント(Vite)のオリジン。開発時は http://localhost:80 など。
# カンマ区切りで複数指定可。* で全許可。
CORS_ORIGIN=http://localhost:80,http://localhost:5173
