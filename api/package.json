{
  "name": "react-transcribe-api",
  "version": "1.0.0",
  "description": "Real-time transcription backend (Express + Socket.IO + Amazon Transcribe Streaming) in TypeScript",
  "license": "MIT-0",
  "type": "module",
  "main": "dist/server.js",
  "scripts": {
    "build": "tsc",
    "start": "node dist/server.js",
    "dev": "tsx watch src/server.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@aws-sdk/client-bedrock-runtime": "^3.1140.0",
    "@aws-sdk/client-transcribe-streaming": "^3.658.0",
    "cors": "^2.8.5",
    "express": "^4.21.0",
    "socket.io": "^4.8.1"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^22.7.4",
    "tsx": "^4.19.1",
    "typescript": "^5.6.2"
  }
}
